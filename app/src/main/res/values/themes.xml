<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DiplomSMKAndroid" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_body</item>
        <item name="android:colorBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/bg_page</item>
    </style>

    <!-- Card style -->
    <style name="Widget.App.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="cardBackgroundColor">@color/bg_card</item>
    </style>

    <!-- Primary button -->
    <style name="Widget.App.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Accent (CTA) button -->
    <style name="Widget.App.Button.Accent" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Ghost (outlined) button -->
    <style name="Widget.App.Button.Ghost" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Chip/Filter button -->
    <style name="Widget.App.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/bg_input</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="chipCornerRadius">999dp</item>
    </style>

    <!-- Badge -->
    <style name="Badge">
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Badge.Primary">
        <item name="android:background">@drawable/bg_badge_primary</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Badge.Success">
        <item name="android:background">@drawable/bg_badge_success</item>
        <item name="android:textColor">@color/success_dark</item>
    </style>

    <style name="Badge.Warning">
        <item name="android:background">@drawable/bg_badge_warning</item>
        <item name="android:textColor">@color/warning_dark</item>
    </style>

    <style name="Badge.Danger">
        <item name="android:background">@drawable/bg_badge_danger</item>
        <item name="android:textColor">@color/danger_dark</item>
    </style>

    <!-- Full-screen dialog style (profile overlay) -->
    <style name="Theme.DiplomSMKAndroid.FullScreenDialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <!-- Circle image for avatars -->
    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>